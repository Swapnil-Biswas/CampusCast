# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Alerts (stage 5). Generate VAPID keys with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:college@example.edu
JOB_SECRET=a-long-random-string-shared-with-the-database
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
# Email (Brevo SMTP or any SMTP server)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusCast <college@example.edu>

# Examination PDFs: AI reading (stage 6). Create a key at console.anthropic.com. Server-side only: never prefix it NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Free: a Google Gemini key from aistudio.google.com (reads typed and scanned PDFs).
GEMINI_API_KEY=
# Free backup: a Groq key from console.groq.com (typed PDFs only). Used when the one above is rate limited or down.
GROQ_API_KEY=
# Optional: use only one provider (anthropic, gemini or groq), and pin models.
EXAM_AI_PROVIDER=
EXAM_AI_MODEL=
GEMINI_MODEL=
GROQ_MODEL=
# Optional. The model that reads the PDFs; defaults to claude-sonnet-5-5.
EXAM_AI_MODEL=
